---
import { experience } from "../data/content.js";
import Words from "./Words.astro";
import DiscoBall from "./stickers/DiscoBall.astro";
const [first, ...rest] = experience.title.split(" ");
---
<section class="xp-sec" id="trajetoria" aria-labelledby="xp-title">
  <div class="wrap">
    <div class="xp-head">
      <div class="xp-head__deco" data-loop>
        <DiscoBall class="xp-disco loop" data-reveal="sticker" />
      </div>
      <div>
        <p class="kicker kicker--right" data-reveal="up">trajetória</p>
        <h2 id="xp-title" class="xp-title" data-split>
          <Words text={[first, ...rest.slice(0, -1)].join(" ")} /> <span class="serif"><Words text={rest[rest.length - 1]} /></span>
        </h2>
      </div>
    </div>
    <ol class="xp">
      {experience.items.map((item) => (
        <li class:list={["xp__item", { "xp__item--current": item.current }]} data-reveal="xp" data-loop={item.current ? "" : undefined}>
          <p class="xp__dates">
            {item.current && <span class="xp__dot loop" aria-hidden="true"></span>}
            <span>{item.dates}</span>
          </p>
          <div class="xp__head">
            <h3 class="xp__role">{item.role}</h3>
            {item.company && <p class="xp__company">{item.company}</p>}
          </div>
          <p class="xp__text">{item.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
