---
import { closing, contact, hero, art } from "../data/content.js";
import Obj from "./Obj.astro";

// só aparecem os contatos preenchidos em content.js
const items = [
  contact.email && { label: "e-mail", value: contact.email, href: `mailto:${contact.email}` },
  contact.linkedin && { label: "linkedin", value: contact.linkedin.replace(/^https?:\/\/(www\.)?/, ""), href: contact.linkedin, external: true },
  contact.instagram && { label: "instagram", value: contact.instagram.replace(/^https?:\/\/(www\.)?/, ""), href: contact.instagram, external: true },
  contact.phone && { label: "telefone", value: contact.phone, href: `tel:${contact.phone.replace(/[^\d+]/g, "")}` },
].filter(Boolean);
---
<section class="contact" id="contato" aria-labelledby="contact-title">
  <div class="wrap contact__inner">
    <Obj src={art.estrelaPreta} class="contact__estrela" data-sticker />
    <Obj src={art.celular} class="contact__celular" data-sticker />
    <h2 id="contact-title" class="contact__title" aria-label={closing.title.join(" ")}>
      <span class="contact__w script" data-write>{closing.title[0]}</span>
      <span class="contact__w caps" data-follow>{closing.title[1]}</span>
    </h2>
    {items.length > 0 && (
      <ul class="contact__list">
        {items.map((it) => (
          <li>
            <span class="contact__label">{it.label}</span>
            <a href={it.href} {...(it.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>{it.value}</a>
          </li>
        ))}
      </ul>
    )}
  </div>
  <footer class="footer wrap">
    <p>{hero.firstName} {hero.lastName} · {hero.subtitle[2]}</p>
    <p>{closing.footer}</p>
  </footer>
</section>
